build/
build-*/
.cache/
compile_commands.json
imgui.ini
opencode-rag.json
.opencode
# The maintained wiki is project knowledge and must remain git-trackable.
# Keep the rest of .opencode local; unignore only the placement page updated here.
!/.opencode/
!/.opencode/wiki/
!/.opencode/wiki/concepts/
!/.opencode/wiki/concepts/layer-placement.md

# assets/ holds the SHARED library (textures, models) and stays tracked.
# World content (manifest, terrain, layers, micro) lives in scenery/<Name>/.
# The live-edit session overlay is state, not content: the app rewrites it on
# every brush stroke and restores it at startup, so it is gitignored per
# scenery. The pointer file is user state too (which scenery was last used).
scenery/last.json
scenery/*/runtime_edits.vxw
# vf_mcp v2 live-lane intent queue + engine reports (session state, not content).
scenery/*/mcp_intents.jsonl
scenery/*/mcp_results.jsonl
scenery/*/*.bak
# The SKELETON caches are DERIVED from a micro layer's own voxels (the app
# writes them next to the layer the first time it loads one). They are a cache,
# not content: the cache carries the layer's signature, so an edited layer
# invalidates it and the rig is derived again.
scenery/*/micro/*.rig
# The MESH BINDING (`.skin`) is derived the same way: it is 100% a function of
# (meshSource, rig), regenerated by `vf_micro_skin`, so tracking it makes every
# asset swap a 275,912-line diff with an unreadable content change. Same rule
# as the rig cache: regenerable, therefore not content.
scenery/*/micro/*.skin

# Convenience symlink into build/ output + local scratch screenshots.
/voxelforge
.opencode/scratch/
.opencode/sidebar-*.png
scenery/*/bin/

# Local screenshots produced by the in-app AI agent's render_shot calls.
/workspace/screenshots/*
!/workspace/screenshots/.gitkeep
# Dedicated in-app OpenCode session IDs are local state.
.opencode/voxelforge_sessions.json
