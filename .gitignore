build/
build-*/
.cache/
compile_commands.json
imgui.ini
opencode-rag.json
.opencode
# The maintained wiki is project knowledge and must remain git-trackable.
# Keep the rest of .opencode local; unignore only the placement page updated here.
!/.opencode/
!/.opencode/wiki/
!/.opencode/wiki/concepts/
!/.opencode/wiki/concepts/layer-placement.md

# assets/ IS tracked (textures, layer .vxw files, world.json - the authored
# scene is the source of truth and must be versioned). The only exception is
# the live-edit session overlay: the app rewrites it on every brush stroke and
# restores it at startup, so it is state, not content.
assets/runtime_edits.vxw
# The SKELETON caches are DERIVED from a micro layer's own voxels (the app
# writes them next to the layer the first time it loads one). They are a cache,
# not content: the cache carries the layer's signature, so an edited layer
# invalidates it and the rig is derived again.
assets/micro/*.rig

# Convenience symlink into build/ output + local scratch screenshots.
/voxelforge
.opencode/scratch/
.opencode/sidebar-*.png
