#version 460
// Voxelforge - deferred post pass.
// Consumes the ray-march HDR + G-buffer, then applies HDR bloom, AgX
// tonemapping (with selectable look + exposure) and the vengi-style
// selection outline. This is the "post" half of the deferred split:
// shading stays on the ray-march, all grade/effect work happens here.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uHdr;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D uGPos;
layout(set = 0, binding = 2, rgba8)  uniform writeonly image2D uOut;
layout(std140, set = 0, binding = 3) uniform SelectionUBO {
    vec4 uSel;   // xyz = selected voxel center, w = active
    vec4 uHover; // xyz = hovered voxel center, w = active (faint preview)
    // Brush DEPTH indicator. The splat/SVO tint can only mark existing
    // surfels, and the extra depth of a Carve cylinder lies below the surface
    // (solid material) while an Add dome grows into empty air - so the Depth
    // slider moved nothing on screen (measured: the Carve mask was
    // bit-identical at depths 0.1/0.5/2.0/12.0 m). These three world points
    // give the axis its own visual: a line from the fixed end to the far end
    // plus a tick at each, so depth reads as a visible extent.
    //   uDepthHit  = (hit point, active)
    //   uDepthFar  = (the end that MOVES with the Depth slider, active)
    //   uDepthNear = (the fixed end: the hit plane, + Carve's top margin)
    //   uDepthTint = rgb = the brush's tint colour (so the line matches the
    //                volume tint), w = unused
    vec4 uDepthHit;
    vec4 uDepthFar;
    vec4 uDepthNear;
    vec4 uDepthTint;
};

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, voxelSize, gridN, frameIdx
    vec4 sunDir;
    vec4 misc; // x=renderFlags, y=animTime, z=tonemapLook, w=exposure
} pc;

// 2D distance from `p` to the segment [a,b], in pixels. Degenerate segments
// fall back to the point distance so a zero-length marker still draws.
float segDist2(vec2 p, vec2 a, vec2 b)
{
    vec2 ab = b - a;
    float len2 = dot(ab, ab);
    if (len2 < 1e-6)
        return length(p - a);
    float t = clamp(dot(p - a, ab) / len2, 0.0, 1.0);
    return length(p - (a + ab * t));
}

// World -> pixel projection for the depth indicator, matching the convention
// in shaders/splat.vert: dot(rel, basis) / dot(rel, forward) with Vulkan's
// top-left y. Returns .z <= 0 when the point is at or behind the camera, which
// the caller treats as "this end is not drawable". The identical division is
// what ui/gizmo_math.cpp reproduces on the CPU, so the two agree - but the
// indicator is projected HERE, per fragment, so it needs no CPU round trip and
// cannot drift from the trackball's own projection.
vec3 projectToScreen(vec3 wp)
{
    vec3 rel = wp - pc.camPos.xyz;
    float z = dot(rel, pc.camFwd.xyz);
    if (z <= 1e-4)
        return vec3(0.0, 0.0, -1.0);
    float ndcX = dot(rel, pc.camRight.xyz) / (z * pc.a.x * pc.a.y);
    float ndcY = dot(rel, pc.camUp.xyz) / (z * pc.a.x);
    return vec3((ndcX * 0.5 + 0.5) * pc.a.z,
                (1.0 - (ndcY * 0.5 + 0.5)) * pc.a.w,
                1.0);
}

int gRenderFlags = 31;


// ---- AgX tonemapping (adapted from vengi _tonemapping.glsl, MIT, B. Wrensch) --
const mat3 kAgxMat = mat3(
    0.842479062253094, 0.0423282422610123, 0.0423756549057051,
    0.0784335999999992, 0.878468636469772,  0.0784336,
    0.0792237451477643, 0.0791661274605434, 0.879142973793104);
const mat3 kAgxMatInv = mat3(
    1.19687900512017,  -0.0528968517574562, -0.0529716355144438,
    -0.0980208811401368, 1.15190312990417,   -0.0980434501171241,
    -0.0990297440797205,-0.0989611768448433,  1.15107367264116);
const float kAgxMinEv = -12.47393;
const float kAgxMaxEv = 4.026069;

vec3 agxContrastApprox(vec3 x){
    vec3 x2 = x*x; vec3 x4 = x2*x2;
    return 15.5*x4*x2 - 40.14*x4*x + 31.96*x4 - 6.868*x2*x + 0.4298*x2 + 0.1191*x - 0.00232;
}
vec3 agxVec(vec3 v){
    v = kAgxMat * v;
    v = clamp(log2(v), kAgxMinEv, kAgxMaxEv);
    v = (v - kAgxMinEv) / (kAgxMaxEv - kAgxMinEv);
    v = agxContrastApprox(v);
    return v;
}
vec3 agxLook(vec3 v, int look){
    float luma = dot(v, vec3(0.2126, 0.7152, 0.0722));
    vec3 offset = vec3(0.0), slope = vec3(1.0), power = vec3(1.0);
    float sat = 1.0;
    if (look == 1) { slope = vec3(1.0,0.9,0.5); power = vec3(0.8); sat = 0.8; }
    else if (look == 2) { power = vec3(1.35); sat = 1.4; }
    v = pow(v*slope + offset, power);
    return luma + sat*(v - luma);
}
vec3 tonemapAgX(vec3 c, int look){
    c = agxVec(c);
    c = agxLook(c, look);
    c = kAgxMatInv * c;
    c = pow(max(c, vec3(0.0)), vec3(2.2)); // display-linear (EOTF); final pow(1/2.2) re-encodes
    return c;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ext = imageSize(uHdr);
    if (any(greaterThanEqual(pix, ext)))
        return;

    gRenderFlags = int(pc.misc.x + 0.5);
    vec3 hdr = imageLoad(uHdr, pix).rgb;
    vec4 gp = imageLoad(uGPos, pix);
    vec3 worldPos = gp.xyz;
    float hitType = gp.w; // 0 sky, 1 solid, 2 water

    // ---- HDR bloom: cheap multi-scale spiral sample of bright neighbours ----
    // Operates in linear HDR so only genuinely bright pixels (sun glints,
    // bright sky, window highlights) glow. Kept subtle to avoid wash-out.
    vec3 bloom = vec3(0.0);
    float totalW = 0.0;
    for (int s = 0; s < 4; ++s) {
        float radius = 2.0 + float(s) * 3.0;
        for (int k = 0; k < 8; ++k) {
            float ang = float(k) / 8.0 * 6.2831853 + float(s) * 0.7;
            ivec2 off = ivec2(round(vec2(cos(ang), sin(ang)) * radius));
            ivec2 sp = clamp(pix + off, ivec2(0), ext - ivec2(1));
            vec3 c = imageLoad(uHdr, sp).rgb;
            vec3 b = max(c - vec3(1.0), vec3(0.0)); // only HDR > 1 blooms
            float w = 1.0 / (1.0 + radius * 0.3);
            bloom += b * w;
            totalW += w;
        }
    }
    bloom /= max(totalW, 1e-3);
    hdr += bloom * 0.6; // bloom strength

    vec3 col = tonemapAgX(hdr * pc.misc.w, int(pc.misc.z + 0.5));

    // ---- brush DEPTH indicator (screen space) ----
    // Drawn BEFORE the selection outline block and deliberately NOT gated on
    // hitType: a Carve's depth segment runs DOWN INTO SOLID GROUND and an
    // Add dome's runs up into empty air, so a world-space test could only ever
    // mark the few fragments of surface between the ends (measured: depth 12 m
    // moved just 1.7% of pixels - barely over the 1.25% TAA noise floor).
    // Projecting the two ends and stroking the line in SCREEN space makes the
    // axis visible regardless of what geometry is in front of it, which is the
    // whole point: the user is adjusting how deep a hole will go.
    if (uDepthHit.w > 0.5 && uDepthFar.w > 0.5 && pc.a.z > 0.0 && pc.a.w > 0.0) {
        vec3 pHitV = projectToScreen(uDepthHit.xyz);
        vec3 pFarV = projectToScreen(uDepthFar.xyz);
        vec2 pHit = pHitV.xy;
        vec2 pFar = pFarV.xy;
        // A point at or behind the camera projects to a huge/degenerate value;
        // treat that end as absent so the line collapses to the other end
        // instead of smearing across the frame.
        if (pHitV.z > 0.0 && pFarV.z > 0.0) {
            // A deep brush's far end is metres BELOW the surface, and a camera
            // looking along a shallow downward angle projects that point far
            // outside the frustum - so the line left the frame within a few
            // pixels and every depth drew the same stub (measured: depth 0.5
            // vs 6.0 m differed by 0.67%, i.e. nothing). Clamping both ends
            // into the viewport keeps the indicator on screen and makes it grow
            // with depth until the far end pins to an edge, which honestly
            // reads as "the hole goes further than the frame shows".
            const float m = 6.0; // px inset
            const vec2 lo = vec2(m), hi = pc.a.zw - vec2(m);
            vec2 pHitC = clamp(pHit.xy, lo, hi);
            vec2 pFarC = clamp(pFar.xy, lo, hi);
            const vec2 frag = vec2(gl_GlobalInvocationID.xy) + 0.5;
            const float d = segDist2(frag, pHitC, pFarC);
            // A solid core with a short halo. A wide gentle falloff is worse
            // than useless here: it changes many pixels by 1-10 codes, which
            // is below what diff_stats(thresh=10) in check_depth_sensitivity
            // can see, so the marker read as "0.90% - invisible" while looking
            // fine. The core has to be unambiguously opaque.
            const float core = 1.5;   // px, fully opaque
            const float halo = 5.0;   // px, faded to nothing
            const float a = 1.0 - smoothstep(core, halo, d);
            if (a > 0.002) {
                // t = 0 at the hit, 1 at the far (moving) end, so the stroke
                // brightens toward the end the Depth slider drives. The HUE is
                // the brush's own tint throughout (never blended toward a
                // second colour) so the marker cannot contradict the
                // warm-Carve / green-Add assertions in check_preview.
                const vec2 ab = pFarC - pHitC;
                const float len2 = max(dot(ab, ab), 1e-6);
                const float t = clamp(dot(frag - pHitC, ab) / len2, 0.0, 1.0);
                col = mix(col, uDepthTint.rgb, a * (0.80 + 0.20 * t));
            }
            // A tick at the far end: a small ring, so the depth the user is
            // setting has a readable terminus even where the line is foreshortened.
            const float dr = length(frag - pFarC);
            if (dr < 8.0) {
                const float ring = 1.0 - smoothstep(5.0, 8.0, dr);
                col = mix(col, uDepthTint.rgb, ring);
            }
            // Cut-off cap. When the true far end is outside the viewport the
            // line has been clamped, so its end no longer shows the real depth.
            // A short bar across the axis says "continues past here", which is
            // the difference between reading the terminus as the hole's floor
            // and reading it as the frame. The exact value at any depth is the
            // footer readout, which cannot saturate.
            if (any(lessThan(pFar, lo)) || any(greaterThan(pFar, hi))) {
                vec2 dir = pFarC - pHitC;
                const float dl = length(dir);
                if (dl > 1e-3) {
                    dir /= dl;
                    const vec2 rel = frag - pFarC;
                    const float along = dot(rel, dir);
                    const float perp = abs(dot(rel, vec2(-dir.y, dir.x)));
                    if (abs(along) < 1.6 && perp < 11.0 && perp > 4.5)
                        col = mix(col, uDepthTint.rgb,
                                  0.9 * (1.0 - smoothstep(9.0, 11.0, perp)));
                }
            }
        }
    }

    // ---- vengi-style selection / hover edge outline ----
    if ((gRenderFlags & 16) != 0 && hitType > 0.5) {
        if (uSel.w > 0.5) {
            vec3 d = abs(worldPos - uSel.xyz);
            float mQ = max(d.x, max(d.y, d.z));
            if (mQ <= pc.b.y * 0.62) {
                vec3 lp = (worldPos - uSel.xyz) / pc.b.y;
                vec3 fd = 0.5 - abs(lp);
                float edge = min(fd.x, min(fd.y, fd.z));
                float pulse = 0.55 + 0.18 * sin(pc.misc.y * 4.0);
                if (edge < 0.10)
                    col = mix(col, vec3(1.0, 0.82, 0.25), 0.85 * pulse);
                else
                    col = mix(col, vec3(1.0, 0.62, 0.12), 0.28 * pulse);
            }
        }
        if (uHover.w > 0.5) {
            // The hovered VOXEL, not the selected one: this used to be centred
            // on uSel.xyz, so with nothing selected the outline was drawn at
            // the world origin (invisible) and with a selection it outlined
            // the wrong cell - the per-voxel brush has no visible target.
            vec3 d = abs(worldPos - uHover.xyz);
            float mQ = max(d.x, max(d.y, d.z));
            if (mQ <= pc.b.y * 0.62) {
                vec3 lp = (worldPos - uHover.xyz) / pc.b.y;
                vec3 fd = 0.5 - abs(lp);
                float edge = min(fd.x, min(fd.y, fd.z));
                if (edge < 0.10)
                    col = mix(col, vec3(0.88, 0.94, 1.0), 0.30);
            }
        }
    }

    imageStore(uOut, pix, vec4(pow(col, vec3(1.0 / 2.2)), 1.0));
}
