#version 460
#extension GL_GOOGLE_include_directive : require
#define SPLAT_BACKEND 1
// Voxelforge tile splat renderer (unified compute pass).
//
// Replaces the two forward raster passes (opaque Gaussian-alpha + water)
// with a single per-pixel loop over the tile's dup list. The dup stream is
// built by the (tile, entry) counting scheme: base[tile][entry] + localIdx
// places entry e's local surfel i at a unique slot, so within-tile order =
// (entry asc, local asc) = the forward submission order EXACTLY (far->near
// opaque, then water; instance order within a draw). The per-layer math
// below mirrors splat.frag's main() branch-for-branch:
//
//  - per-pixel state (hdr, gpos, depth=1.0) replaces the HDR/G-buffer/depth
//    attachments; blending happens in registers (no framebuffer read-modify-
//    write stalls)
//  - a first loop replicates the PASS_MODE 3 prepass: the nearest full-disk
//    opaque plane depth. The second loop applies the same depth resolve as
//    the opaque pipe (fragment depth biased by -tol, LESS against the
//    prepass): only the front surface band blends, so far surfaces inside a
//    chunk cannot source-over in draw order (dark-speckle free)
//  - every surviving opaque surfel contributes a pure Gaussian alpha
//    (opacity*exp(-0.5*d2/sigma2)), straight-colour source-over, exactly the
//    opaque pipe blend
//  - water surfels ride in the same dup stream (pass bit 1, after opaque),
//    depth-tested against the tracked prepass depth, blended premultiplied
//    like the water pipe (col*a^2 + dst*(1-a))
//  - gpos is written by every surviving layer (no blend on att1, like HW)

struct Surfel {
    vec4 pos_rU;
    vec4 normal_rV;
    vec4 bent_sh;
    vec4 mat_ao;
};

layout(set = 0, binding = 0) readonly buffer Surfels { Surfel uSurfels[]; };
layout(set = 0, binding = 1, rg32f) uniform readonly highp image2D uHeight;
layout(set = 0, binding = 2, r8_snorm) uniform readonly highp image3D uObjVol;
layout(set = 0, binding = 14, rgba16f) uniform highp image2D uHdr;
layout(set = 0, binding = 15, rgba16f) uniform highp image2D uGPos;

layout(std140, set = 0, binding = 3) uniform SplatUBO {
    vec4 uSplat;  // x=buried, y=sigma2, z=quad extent, w=debug mode
    vec4 uSplat2; // x=radius scale, y=opacity, z/w=spare
} sp;

layout(set = 0, binding = 6) readonly buffer TileOffsets { uint uTileOffsets[]; };
layout(set = 0, binding = 7) readonly buffer TileEnds { uint uTileEnds[]; };
layout(set = 0, binding = 10) readonly buffer DupVals { uint uDupVals[]; };
layout(set = 0, binding = 20) readonly buffer TotalFb { uint uTotalFb[]; };

layout(std140, set = 0, binding = 8) uniform Frame {
    vec4 uTileInfo; // x = tilesX, y = tilesY, z = nEntries, w = scanN
    vec4 uSortInfo; // x = dupCap, y = slot
} fr;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b;
    vec4 sunDir;
    vec4 misc; // x=renderFlags, y=animTime, z=tonemapLook, w=exposure
} pc;

const float kWaterLevel = -0.9;

#include "common_base.glsl"
#include "common_splat.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

struct DiskHit {
    float t;
    float d2;
    vec3 n; // possibly flipped for two-sided shells
};

// exact ray/disk intersection, identical to the FS + bin pass rules
bool diskHit(Surfel s, vec3 ro, vec3 rd, bool noCollapse, float extent,
             float rScale, out DiskHit h)
{
    const vec3 c = s.pos_rU.xyz;
    h.n = normalize(s.normal_rV.xyz);
    const float facing = dot(h.n, ro - c);
    const float rU = max(s.pos_rU.w, 1e-4) * rScale;
    const float rV = max(s.normal_rV.w, 1e-4) * rScale;
    const float matf = s.mat_ao.x;
    const bool thinShell = abs(matf - 8.0) < 0.5 || abs(matf - 7.0) < 0.5;
    if (facing < 0.0 && !noCollapse && !thinShell)
        return false;
    if (facing < 0.0 && thinShell)
        h.n = -h.n;
    const vec3 upRef = abs(h.n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    const vec3 tT = normalize(cross(h.n, upRef));
    const vec3 tB = normalize(cross(h.n, tT));
    const float denom = dot(rd, h.n);
    if (abs(denom) < 1e-6)
        return false;
    h.t = dot(c - ro, h.n) / denom;
    if (h.t <= 0.0)
        return false;
    const vec3 q = ro + rd * h.t;
    const float u = dot(q - c, tT) / max(rU, 1e-5);
    const float v = dot(q - c, tB) / max(rV, 1e-5);
    h.d2 = u * u + v * v;
    return h.d2 <= extent * extent;
}

void main()
{
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    const int W = int(pc.a.z + 0.5);
    const int H = int(pc.a.w + 0.5);
    if (pix.x >= W || pix.y >= H)
        return;
    // dup-stream overflow (see scan): skip, record() falls back to forward
    if (uTotalFb[uint(fr.uSortInfo.y + 0.5) * 5u + 4u] != 0u)
        return;
    // debug views fall back to the forward path (record() routes there);
    // never shade them here
    if (sp.uSplat.w > 0.5)
        return;

    kSunDir = normalize(pc.sunDir.xyz);
    gRenderFlags = int(pc.misc.x + 0.5);
    vec3 ro = pc.camPos.xyz;
    gUnderwater = ((gRenderFlags & 8) != 0) && ro.y < kWaterLevel && underWater(ro.xz);

    // exact per-pixel ray (== the FS's perspective-correct vView at the
    // pixel centre); NDC y=-1 is the top row under the VS projection
    const vec2 ndcPx = vec2((float(pix.x) + 0.5) / float(W) * 2.0 - 1.0,
                            (float(pix.y) + 0.5) / float(H) * 2.0 - 1.0);
    const vec3 rd = normalize(pc.camFwd.xyz + ndcPx.x * pc.a.x * pc.a.y * pc.camRight.xyz
                                               - ndcPx.y * pc.a.x * pc.camUp.xyz);

    // per-pixel compositing state (== HDR/G-buffer/depth targets)
    vec4 hdr = imageLoad(uHdr, pix);
    vec4 gpos = imageLoad(uGPos, pix);

    const int tilesX = int(fr.uTileInfo.x + 0.5);
    const uint tile = uint((pix.y / 16) * tilesX + (pix.x / 16));
    // dup-stream range: exclusive per-tile offset + end (scan + base)
    const uint b0 = uTileOffsets[tile];
    const uint b1 = uTileEnds[tile];
    if (b0 >= b1)
        return;
    const float extent = max(sp.uSplat.z, 1.0);
    const float rScale = clamp(sp.uSplat2.x, 0.5, 2.0);
    const float sigma2 = max(sp.uSplat.y, 1e-3);
    const float depthTol = max(sp.uSplat2.z, 0.0);
    const bool noCollapse = sp.uSplat.x > 0.5; // buried (debug excluded above)

    // Pass 1: prepass mirror — nearest full-disk opaque plane depth over the
    // whole tile list (no alpha gate, water excluded), like PASS_MODE 3.
    float depth = 1.0;
    for (uint b = b0; b < b1; ++b) {
        Surfel s = uSurfels[uDupVals[b]];
        if (s.mat_ao.w > 1.5)
            continue; // water has its own path, never seeds depth
        DiskHit h;
        if (!diskHit(s, ro, rd, noCollapse, extent, rScale, h))
            continue;
        const float fd = floor((1.0 - exp(-h.t * 0.02)) * 100000.0 + 0.5) / 100000.0;
        depth = min(depth, fd);
    }

    // Pass 2: blend in forward submission order (far->near opaque, then
    // water). The opaque resolve mirrors the hardware test exactly: bias the
    // fragment depth by -tol and require it strictly LESS than the prepass
    // depth, so only the front surface band accumulates.
    for (uint b = b0; b < b1; ++b) {
        Surfel s = uSurfels[uDupVals[b]];
        DiskHit h;
        if (!diskHit(s, ro, rd, noCollapse, extent, rScale, h))
            continue;
        const vec3 n = h.n;
        const float d2 = h.d2;
        float t = h.t;
        vec3 q = ro + rd * t;

        const vec4 vMat = s.mat_ao;
        const bool isWater = vMat.w > 1.5;

        // pure Gaussian alpha (mirrors splat.frag PASS_MODE 1); the discard
        // threshold also frees pixels from far sub-threshold ghosts.
        float alpha = 0.0;
        float fragDepthQ = 0.0;
        if (!isWater) {
            fragDepthQ =
                floor((1.0 - exp(-t * 0.02)) * 100000.0 + 0.5) / 100000.0;
            if (!(fragDepthQ - depthTol < depth))
                continue;
            alpha = sp.uSplat2.y * exp(-0.5 * d2 / sigma2);
            if (alpha < 0.004)
                continue;
        }

        const float aoBaked = vMat.w - (isWater ? 2.0 : 0.0);
        vec3 col;
        float hitType = 1.0;
        if (isWater) {
            // PLANAR water: identical to the FS water branch
            const float tW = (kWaterLevel - ro.y) / rd.y;
            if (!(tW > 0.0))
                continue;
            const float fragDepthQ =
                floor((1.0 - exp(-tW * 0.02)) * 100000.0 + 0.5) / 100000.0;
            if (!(fragDepthQ < depth))
                continue;
            const vec3 pw = ro + rd * tW;
            float wa = 1.0;
            col = shadeWaterSplat(pw, rd, ro, tW, wa);
            alpha = wa;
            hitType = 2.0;
            t = tW;
            q = pw;
        } else {
            const uint mId = uint(vMat.x + 0.5);
            const vec3 alb = kPalette[clamp(mId, 0u, 16u)];
            const vec2 rr = vec2(vMat.y, vMat.z) / 255.0;
            const float shB = ((gRenderFlags & 2) != 0 && dot(n, kSunDir) > 0.02)
                                  ? s.bent_sh.w
                                  : 1.0;
            const float aoB = ((gRenderFlags & 1) != 0) ? clamp(aoBaked, 0.0, 1.0) : 1.0;
            const vec3 bentB = normalize(s.bent_sh.xyz);
            col = shadeSurfel(q, rd, alb, rr, ro, n, bentB, shB, aoB, mId);
            const float fog = 1.0 - exp(-t * 0.0016);
            vec3 fc = fogColor(rd, q);
            const float mist = mistFactor(ro, q, t);
            fc = mix(fc, fc * vec3(1.04, 0.99, 0.94) + vec3(0.02, 0.015, 0.01), mist);
            col = mix(col, fc, clamp(fog + mist * 0.45, 0.0, 1.0));
        }

        if (gUnderwater) {
            col *= exp(-t * vec3(0.35, 0.18, 0.12) * 3.0);
            col = mix(col, vec3(0.05, 0.14, 0.13), clamp(t * 0.8, 0.0, 0.85));
        }

        if (isWater) {
            // water pipe: depth-tested against the prepass depth (nearest
            // opaque full-disk plane), blended, no depth write. The FS
            // outputs premultiplied (col*alpha) and the pipe blends with
            // (SRC_ALPHA, ONE_MINUS_SRC_ALPHA), so the net is
            // col*a^2 + dst*(1-a) — mirrored exactly here.
            hdr.rgb = hdr.rgb * (1.0 - alpha) + col * alpha * alpha;
            hdr.a = hdr.a * (1.0 - alpha) + alpha;
            gpos = vec4(q, hitType);
        } else if (fragDepthQ == depth) {
            // opaque base (PASS_MODE 4 mirror): the exact nearest fragment
            // writes opaque colour so the sky can never bleed through the
            // band's low-alpha rims. Encountered last in the far->near walk,
            // so it replaces any earlier band blend — the forward base pass
            // is drawn first and the band over it; with the base nearest the
            // two orders agree to first order.
            hdr = vec4(col, 1.0);
            gpos = vec4(q, hitType);
        } else {
            // opaque band: straight colour source-over in back-to-front
            // draw order (the depth resolve above is the HW test mirror).
            hdr.rgb = hdr.rgb * (1.0 - alpha) + col * alpha;
            hdr.a = hdr.a * (1.0 - alpha) + alpha;
            gpos = vec4(q, hitType);
        }
    }

    imageStore(uHdr, pix, hdr);
    imageStore(uGPos, pix, gpos);
}
