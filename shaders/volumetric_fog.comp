#version 460
#extension GL_GOOGLE_include_directive : require
// Voxelforge - volumetric atmosphere (render flag J).
//
// Low-altitude Rayleigh + Mie in-scatter integrated along the ACTUAL view
// ray: the march runs from the camera to the distance stored in the G-buffer
// (m_gpos.w == hit type, xyz == world hit), so the surface in front of a
// pixel terminates its own ray. That is what bounds the effect - an earlier
// version marched a fixed 16 m from the camera regardless of where the
// surface was, so it accumulated extinction *through* nearby geometry and
// darkened ~42% of the hero frame below luma 20.
//
// Sky pixels have no hit, so they march a fixed far distance instead, which
// gives the horizon its haze gradient.
//
// The shader is deliberately self-contained (no common_base.glsl include):
// it needs no sky model (the sky is already in uScene), no heightfield
// (the G-buffer is the occluder) and no object volume, so the pass keeps its
// three-binding descriptor layout. fbm/vnoise are duplicated here in their
// minimal form because common_base's versions drag in uHeight/uObjVol.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uScene;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D uGPos;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uOut;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, voxelSize, gridN, frameIdx
    vec4 sunDir; // toward the sun
    vec4 misc;   // x=renderFlags, y=animTime, z=tonemapLook, w=exposure
} pc;

const float kWaterLevel = -0.9;

// --- atmosphere constants ---------------------------------------------------
// Extinction at the water table (1/m). Optical depth over a 50 m horizontal
// ray is ~45 * kFogBase, so 0.0045 gives a ~20 % haze at that range.
const float kFogBase = 0.0045;
const float kFogHeight = 9.0;   // e-folding height of the density falloff (m)
const float kMieG = 0.62;       // Henyey-Greenstein anisotropy (forward lobe)
// In-scatter is the sky-lit haze colour plus a forward Mie sun lobe. The
// ambient term is what makes this aerial perspective instead of a dimming
// filter: with it the accumulated in-scatter approaches the sky radiance as
// the optical depth grows, so distant geometry fades TOWARD the sky (and a
// dark tree at range lifts) instead of just getting darker.
const vec3 kHazeCol = vec3(0.70, 0.78, 0.90);
const float kAmbient = 1.0;     // sky-ambient scatter scale
const float kSunGlow = 2.5;     // forward Mie sun-lobe scale
const int kSteps = 28;          // per-pixel samples along the ray
const float kFarDist = 140.0;   // marched distance for sky pixels (m)

// deterministic value noise / fbm (same construction as common_base, minimal
// form: the atmosphere only needs 3 octaves of world-locked patchiness)
float hashN(vec2 q) { return fract(sin(dot(q, vec2(127.1, 311.7))) * 43758.5453); }
float vnoise(vec2 q)
{
    vec2 i = floor(q), f = fract(q);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hashN(i), hashN(i + vec2(1, 0)), f.x),
               mix(hashN(i + vec2(0, 1)), hashN(i + vec2(1, 1)), f.x), f.y);
}
float fbm(vec2 q)
{
    float v = 0.0, amp = 0.5;
    for (int i = 0; i < 3; ++i) {
        v += amp * vnoise(q);
        q = q * 2.03 + vec2(7.7, 3.1);
        amp *= 0.5;
    }
    return v;
}

// Henyey-Greenstein phase function (g > 0 = forward scattering)
float hgPhase(float cosT, float g)
{
    float g2 = g * g;
    float d = 1.0 + g2 - 2.0 * g * cosT;
    return (1.0 - g2) / (12.5663706 * pow(max(d, 1e-4), 1.5));
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.a.z) || pix.y >= int(pc.a.w))
        return;

    vec3 scene = imageLoad(uScene, pix).rgb;
    vec4 gp = imageLoad(uGPos, pix);
    vec3 ro = pc.camPos.xyz;
    vec3 sunDir = normalize(pc.sunDir.xyz);

    vec3 rd;
    float tEnd;
    if (gp.w > 0.5) {
        // solid/water: march to the surface hit - the surface terminates the
        // ray, so fog can never accumulate through nearby geometry
        rd = normalize(gp.xyz - ro);
        tEnd = min(length(gp.xyz - ro), kFarDist);
    } else {
        // sky: reconstruct the camera ray (same NDC convention as the splat
        // sky triangle: NDC(-1,-1) is the top-left texel) and march far
        vec2 ndc = (vec2(pix) + 0.5) / vec2(pc.a.z, pc.a.w) * 2.0 - 1.0;
        rd = normalize(pc.camFwd.xyz + ndc.x * pc.a.x * pc.a.y * pc.camRight.xyz
                                        - ndc.y * pc.a.x * pc.camUp.xyz);
        tEnd = kFarDist;
    }

    // per-pixel dither on the first step so the fixed step count does not
    // band on smooth gradients
    float dither = hashN(vec2(pix) + 0.5);
    float stepLen = tEnd / float(kSteps);
    float cosT = dot(rd, sunDir);

    // phase-weighted scattering colour: sky-lit haze (Rayleigh-weighted, so
    // it cools away from the sun) plus the forward Mie lobe that gives the
    // warm glow when looking toward the sun
    float phR = 0.0597 * (1.0 + cosT * cosT) * 4.0;
    float phM = hgPhase(cosT, kMieG);
    vec3 beta = kHazeCol * kAmbient * mix(0.85, 1.15, phR)
              + vec3(1.0, 0.90, 0.72) * phM * kSunGlow;

    vec3 acc = vec3(0.0);
    float tr = 1.0;
    // slow wind drift so the patchiness moves with the world, never the camera
    vec2 wind = vec2(pc.misc.y * 0.010, pc.misc.y * 0.006);
    for (int i = 0; i < kSteps; ++i) {
        float t = (float(i) + dither) * stepLen;
        vec3 sp = ro + rd * t;
        // exponential falloff from the water table: valley fog pools low
        float dens = kFogBase * exp(-max(sp.y - kWaterLevel, 0.0) / kFogHeight);
        // world-locked patchiness (3 octaves), never camera-relative or it swims
        dens *= 0.55 + 0.90 * fbm(sp.xz * 0.06 + wind + sp.y * 0.03);
        if (dens > 1e-6) {
            acc += tr * beta * dens * stepLen;
            // Beer-Lambert, bounded: pure scattering so extinction == density
            tr *= exp(-dens * stepLen);
        }
        if (tr < 0.01)
            break;
    }

    // composite in-scatter over the attenuated scene. uScene is the
    // post-tonemap LDR image, so the accumulated in-scatter is applied in the
    // same (gamma-encoded) space - it reads as haze, not as a re-lighting.
    imageStore(uOut, pix, vec4(scene * tr + acc, 1.0));
}
