#version 460
#extension GL_GOOGLE_include_directive : require
// Voxelforge - Volumetric atmosphere/fog.
// Raymarches through the scene density (heightfield + object volume)
// accumulating Rayleigh + Mie scattering along the view ray.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uScene;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D uGPos;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uOut;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, voxelSize, gridN, frameIdx
    vec4 sunDir;
    vec4 misc;
} pc;

const float kWaterLevel = -0.9;
const float kStepSize = 0.5;
const int kMaxSteps = 32;
const float kMieScale = 0.5;
const float kRayleighScale = 0.8;

int gRenderFlags = 31;

vec3 skyColor(vec3 d)
{
    float cosTheta = clamp(d.y, 0.0, 1.0);
    float cosGamma = max(dot(d, normalize(pc.sunDir.xyz)), 0.0);
    float gamma = acos(clamp(cosGamma, 0.0, 1.0));
    const float T = 2.2;
    float Ay = 0.1787 * T - 1.4630;
    float By = -0.3554 * T + 0.4275;
    float Cy = -0.0227 * T + 5.3251;
    float Dy = 0.1206 * T - 2.5771;
    float Ey = -0.0670 * T + 0.3703;
    float cosThetaSafe = max(cosTheta, 0.07);
    float Ftheta = (1.0 + Ay * exp(By / cosThetaSafe)) / (1.0 + Ay * exp(By));
    float Fgamma = 1.0 + Cy * exp(Dy * gamma) + Ey * cosGamma * cosGamma;
    float Y = Ftheta * Fgamma;
    vec3 base = mix(vec3(0.72, 0.80, 0.90) * 1.05, vec3(0.20, 0.36, 0.62) * 0.95, pow(max(cosTheta, 0.0), 0.55));
    vec3 col = base * (0.82 + 0.30 * clamp(Y * 0.08, 0.0, 1.5));
    col += vec3(1.0, 0.95, 0.84) * 1.35 * 0.55 * pow(cosGamma, 1150.0) * clamp(Y * 0.15, 0.0, 2.0);
    col += vec3(1.0, 0.85, 0.6) * 0.48 * pow(cosGamma, 6.0) * clamp(Y * 0.06, 0.2, 1.2);
    return col;
}

float heightAt(vec2 xz)
{
    return 0.0;
}

void main()
{
    gRenderFlags = int(pc.misc.x + 0.5);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.a.z) || pix.y >= int(pc.a.w)) return;

    vec3 scene = imageLoad(uScene, pix).rgb;
    vec4 gp = imageLoad(uGPos, pix);
    vec3 worldPos = gp.xyz;
    float hitType = gp.w;

    vec3 ro = pc.camPos.xyz;
    vec3 rd;
    if (hitType > 0.5) {
        rd = normalize(worldPos - ro); // march toward the surface hit
    } else {
        // sky: reconstruct the camera ray for this pixel (same convention
        // as the splat sky triangle: NDC(-1,-1) is the top-left texel)
        vec2 ndc = (vec2(pix) + 0.5) / vec2(pc.a.z, pc.a.w) * 2.0 - 1.0;
        rd = normalize(pc.camFwd.xyz + ndc.x * pc.a.x * pc.a.y * pc.camRight.xyz
                                        - ndc.y * pc.a.x * pc.camUp.xyz);
    }

    // Raymarch through volumetric fog
    vec3 col = vec3(0.0);
    float transmittance = 1.0;
    vec3 sunDir = normalize(pc.sunDir.xyz);

    for (int i = 0; i < kMaxSteps; ++i) {
        vec3 sp = ro + rd * float(i) * kStepSize;
        float height = sp.y;

        // Density based on altitude and terrain proximity
        float density = 0.0;
        if (height < 2.0) {
            // Ground fog: denser near ground
            density = max(0.0, 1.0 - (height + 1.0) * 0.5) * 0.3;
        }
        // Add noise for cloud-like variation
        density *= (0.7 + 0.3 * max(0.0, sin(sp.x * 0.5 + sp.z * 0.3)));

        if (density > 0.01) {
            // Rayleigh + Mie scattering
            vec3 rayleigh = vec3(0.55, 0.63, 0.85) * kRayleighScale * density;
            vec3 mie = vec3(0.95, 0.85, 0.65) * kMieScale * density;
            float sunDot = max(dot(-rd, sunDir), 0.0);
            vec3 inscatter = (rayleigh + mie * pow(sunDot, 4.0)) * density * kStepSize;
            col += transmittance * inscatter;
            transmittance *= exp(-density * kStepSize * 2.0);
        }

        if (transmittance < 0.01) break;
    }

    // Combine: valley haze over the tonemapped scene (LDR effect).
    // col is scaled so the toggle reads as atmosphere, not a whiteout.
    vec3 result = scene * transmittance + col * 0.5;
    imageStore(uOut, pix, vec4(result, 1.0));
}
