#version 460
#extension GL_GOOGLE_include_directive : require
// shared lighting model (sky, PBR, AO, fog, palette, flora) lives in
// common_base.glsl + common_svo.glsl
// Voxelforge - chunked-SVO sphere tracer.
// Top-level chunk grid -> per-chunk octree -> 8^3 bricks (packed sdf+color).
// All geometry is data: terrain from the records-derived height texture,
// objects from the baked bricks. No analytic scene constants remain.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Deferred output: linear HDR scene radiance + a tiny G-buffer (world pos +
// hit type) that the post pass tonemaps, blooms and outlines. Keeping the
// post-processing off the ray-march lets us do HDR bloom cheaply.
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D uHdr;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D uGPos;

layout(std430, set = 0, binding = 1) readonly buffer ChunkGrid { int uGrid[]; };
layout(std430, set = 0, binding = 2) readonly buffer ChildBase { uint uChildBase[]; };
layout(std430, set = 0, binding = 3) readonly buffer Payload { uint uPayload[]; };
layout(std430, set = 0, binding = 4) readonly buffer Handles { uint uHandles[]; };
layout(std430, set = 0, binding = 5) readonly buffer Bricks { uint uBricks[]; };
layout(set = 0, binding = 6, rg32f) uniform readonly highp image2D uHeight;
layout(set = 0, binding = 7, r8_snorm) uniform readonly highp image3D uObjVol;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, voxelSize, gridN, frameIdx
    vec4 sunDir; // normalized direction TOWARD the sun
    vec4 misc;   // x = animation time (s)
} pc;

const uint kEmpty = 0xFFFFFFFFu;
const uint kSolid = 0xFFFFFFFEu;
const int BRICK_N = 8;
const int BRICK_WORDS = BRICK_N * BRICK_N * BRICK_N * 2; // rgb+sdf | a+refl+rough+mat
const float kWaterLevel = -0.9;
#include "common_base.glsl"
#include "common_svo.glsl"

void main()
{
    kSunDir = normalize(pc.sunDir.xyz);
    gRenderFlags = int(pc.misc.x + 0.5);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.a.z) || pix.y >= int(pc.a.w))
        return;

    vec2 ndc = (gl_GlobalInvocationID.xy + 0.5) / vec2(pc.a.z, pc.a.w) * 2.0 - 1.0;
    vec3 rd = normalize(pc.camFwd.xyz + ndc.x * pc.a.x * pc.a.y * pc.camRight.xyz -
                        ndc.y * pc.a.x * pc.camUp.xyz);
    vec3 ro = pc.camPos.xyz;
    gUnderwater = ((gRenderFlags & 8) != 0) && ro.y < kWaterLevel && underWater(ro.xz);

    vec3 col;
    float tHit = -1.0;
    bool solidHit = false; // terrain/object surface hit (not water, not sky)
    float gHitType = 0.0;  // G-buffer: 0 sky, 1 solid, 2 water
    vec3 gWorld = vec3(0.0); // G-buffer: world-space hit position
    float t0, t1;
    if (!rayAABB(ro, 1.0 / rd, t0, t1)) {
        col = skyColor(rd);
    } else {
        float t = max(t0, 0.0);
        bool hit = false;
        // Exact SVO/DDA traversal: visits every voxel in ray order, so no voxel
        // is ever missed and cube corners stay sharp (no interpolated-SDF
        // rounding). `t` becomes the entry t of the first solid voxel hit.
        {
            float th;
            if (exactSVOHit(ro, rd, max(t0, 0.0), t1, th)) {
                hit = true;
                t = th;
            } else {
                t = t1;
            }
        }

        // water surface between camera and terrain? (works from above and below)
        // Global plane tested over the whole AABB; only suppressed when a
        // solid surface (terrain/object) is in front of the plane.
        float tWater = waterHit(ro, rd, t1);
        bool waterView = false;
        vec3 pw = ro;
        bool solidBeforeWater = (t <= t1) && (t < tWater);
        if ((gRenderFlags & 8) != 0 && tWater > 0.0 && !solidBeforeWater) {
            pw = ro + rd * tWater;
            t = tWater; hit = true; waterView = true;
            gHitType = 2.0; gWorld = pw;
        }

            if (hit) {
            vec3 p = ro + rd * t;

            if (waterView) {
                // ripple normal (animated in real seconds via pc.misc.y)
                float r1 = sin(p.x*4.5 + pc.misc.y*0.45)*0.5 + sin(p.z*6.0 - p.x*2.5)*0.5;
                float r2 = sin(p.x*9.5 + pc.misc.y*0.8 + p.z*3.5)*0.3 + sin(p.z*13.0 - p.x*6.0 + pc.misc.y*0.3)*0.3;
                vec3 n = normalize(vec3(r1*0.04 + r2*0.05, 1.0, sin(p.x*7.0 - p.z*11.0)*0.06 + cos(p.x*11.0 + p.z*5.0)*0.045));
                bool fromBelow = ro.y < kWaterLevel;
                vec3 nFace = fromBelow ? -n : n;
                float ndv = max(dot(-rd, nFace), 0.0);
                float fres = 0.02 + 0.98*pow(1.0 - ndv, 5.0);
                float sunGlint = pow(max(dot(reflect(rd, nFace), kSunDir), 0.0), 420.0);
                // live shadow on the water surface (terrain + object occluders)
                float wsh = softShadow(pw + nFace * 0.3, kSunDir);

                if (fromBelow) {
                    // internal reflection dives back down into the water/bed
                    vec3 R = reflect(rd, nFace);
                    vec3 rc = skyColor(vec3(R.x, -abs(R.y), R.z));
                    float rth;
                    if (exactSVOHit(pw, R, 0.02, 200.0, rth))
                        rc = shadeFloor(pw + R * rth, R);
                    vec3 skyT = skyColor(vec3(rd.x, abs(rd.y), rd.z));
                    skyT *= vec3(0.55, 0.80, 0.85);
                    col = mix(skyT, rc * mix(vec3(0.45,0.55,0.55), vec3(1.0), wsh), fres)
                          + kSunCol * sunGlint * 3.0 * wsh;
                } else {
                    vec3 R = reflect(rd, n);
                    R.y = abs(R.y);
                    vec3 rc = skyColor(R);
                    float rth;
                    if (exactSVOHit(pw, R, 0.02, 200.0, rth))
                        rc = shadeFloor(pw + R * rth, R);
                    col = mix(vec3(0.04,0.10,0.09), rc * mix(vec3(0.45,0.55,0.55), vec3(1.0), wsh), clamp(fres+0.25,0.0,1.0))
                          + kSunCol * sunGlint * 3.0 * wsh;
                }
                // shoreline foam: thin streaks hugging the waterline
                float bedH = heightAt(pw.xz);
                float shoreF = 1.0 - smoothstep(0.02, 0.26, kWaterLevel - bedH);
                float fp = vnoise(pw.xz * 3.7 + vec2(pc.misc.y * 0.35, -pc.misc.y * 0.22));
                fp = smoothstep(0.66, 0.90, fp + 0.28 * shoreF - 0.20);
                col = mix(col, vec3(0.92, 0.94, 0.95), fp * shoreF * 0.50);
                col = mix(col, fogColor(rd, pw), 1.0-exp(-tWater*0.004));
            } else {
                col = shadeTerrain(p, rd, brickAlbedo(p), brickReflectivity(p), ro);
                float fog = 1.0 - exp(-max(t - t0, 0.0) * 0.0012);
                col = mix(col, fogColor(rd, p), fog);
                tHit = t;
                solidHit = true;
                gHitType = 1.0; gWorld = p;
            }

            // underwater volumetric: camera below the fixed water plane
            if (gUnderwater) {
                float tU = waterView ? tWater : t;
                col *= exp(-tU * vec3(0.35,0.18,0.12) * 3.0);
                col = mix(col, vec3(0.05,0.14,0.13), clamp(tU*0.8, 0.0, 0.85));
            }
        } else {
            col = skyColor(rd);
            if (gUnderwater) {
                float tExit = (rd.y > 0.001) ? (kWaterLevel - ro.y)/rd.y : t1;
                float tU = max(0.0, min(tExit, t1));
                col *= exp(-tU * vec3(0.35,0.18,0.12) * 3.0);
                col = mix(col, vec3(0.05,0.14,0.13), clamp(tU*0.8, 0.0, 0.85));
            }
        }
    }

    // Deferred output: linear HDR scene radiance (pre-tonemap). The post pass
    // applies exposure, AgX tonemapping, bloom and the selection outline.
    // We also stash a tiny G-buffer (world position + hit type) so the post
    // pass can draw the highlight without re-marching.
    //   hitType: 0 = sky, 1 = solid surface, 2 = water surface (set above)
    imageStore(uHdr, pix, vec4(col, 1.0));
    imageStore(uGPos, pix, vec4(gWorld, gHitType));
}
