#version 460
// Voxelforge M1 - dense SDF sphere-tracer.
// One thread per pixel; marches the trilinearly-filtered snorm8 SDF volume.
// Shading model kept identical to svo_raymarch.comp for backend parity.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler3D uSDF;    // R8_SNORM linear
layout(set = 0, binding = 1) uniform sampler3D uAlbedo; // R8G8B8_UNORM nearest
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D uOut;
layout(set = 0, binding = 3, r32f) uniform readonly highp image2D uHeight;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, maxEncodedDist, voxelSize, frameIdx
    vec4 sunDir; // normalized direction TOWARD the sun
    vec4 misc;   // x = splat scale, y = animation time (s)
} pc;

vec3 kSunDir = normalize(vec3(0.42, 0.78, 0.30)); // set from push in main()
const vec3 kSunCol = vec3(1.00, 0.95, 0.84) * 1.35;
const vec3 kZenith = vec3(0.20, 0.36, 0.62);
const vec3 kHorizon = vec3(0.72, 0.80, 0.90);
const vec3 kPalette[9] = vec3[9](
    vec3(0.07,0.52,0.06), vec3(0.16,0.68,0.10), vec3(0.62,0.36,0.14),
    vec3(0.84,0.72,0.38), vec3(0.48,0.42,0.38), vec3(0.66,0.64,0.60),
    vec3(0.62,0.33,0.10), vec3(0.42,0.22,0.10), vec3(0.04,0.52,0.03)
);
const vec2 kMatRefl[9] = vec2[9](
    vec2(35,235)/255.0, vec2(40,230)/255.0, vec2(55,225)/255.0,
    vec2(130,190)/255.0, vec2(95,150)/255.0, vec2(115,135)/255.0,
    vec2(70,160)/255.0, vec2(60,170)/255.0, vec2(30,235)/255.0
);
const float kWaterLevel = -0.9;

// bilinear height sample from the shared terrain heightmap
float heightAt(vec2 xz)
{
    ivec2 sz = imageSize(uHeight);
    vec2 tc = clamp(xz / pc.b.x + 0.5, vec2(0.0), vec2(1.0)) * vec2(sz - 1);
    ivec2 i0 = ivec2(floor(tc));
    ivec2 i1 = min(i0 + 1, sz - 1);
    vec2 f = tc - vec2(i0);
    float h00 = imageLoad(uHeight, ivec2(i0.x, i0.y)).r;
    float h10 = imageLoad(uHeight, ivec2(i1.x, i0.y)).r;
    float h01 = imageLoad(uHeight, ivec2(i0.x, i1.y)).r;
    float h11 = imageLoad(uHeight, ivec2(i1.x, i1.y)).r;
    return mix(mix(h00, h10, f.x), mix(h01, h11, f.x), f.y);
}

bool underWater(vec2 xz) { return heightAt(xz) < kWaterLevel; }

// deterministic value noise (bank foam pattern)
float hashN(vec2 q) { return fract(sin(dot(q, vec2(127.1, 311.7))) * 43758.5453); }
float vnoise(vec2 q)
{
    vec2 i = floor(q), f = fract(q);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hashN(i), hashN(i + vec2(1, 0)), f.x),
               mix(hashN(i + vec2(0, 1)), hashN(i + vec2(1, 1)), f.x), f.y);
}




float sdfAt(vec3 p)
{
    vec3 uvw = p / pc.b.x + 0.5;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
        return pc.b.y;
    float lod = clamp(log2(max(length(p - pc.camPos.xyz) * 0.015, 1.0)), 0.0, 8.0);
    return textureLod(uSDF, uvw, lod).r * pc.b.y;
}
vec3 albedoAt(vec3 p)
{
    vec3 uvw = p / pc.b.x + 0.5;
    float lod = clamp(log2(max(length(p - pc.camPos.xyz) * 0.015, 1.0)), 0.0, 8.0);
    return textureLod(uAlbedo, uvw, lod).rgb;
}

// --- riverside objects (mirror common.hpp; layered bottom-up) ---------------
const vec2 kHousePosG = vec2(6.5, 12.5);
const vec2 kTreePosG  = vec2(10.5, 11.5);
const float kPadYG = -0.40;

float sdBoxF(vec3 p, vec3 c, vec3 b)
{
    vec3 q = abs(p - c) - b;
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}
float sdLogX(vec3 p, float cx, float halfLen, float y, float zOff, float r)
{
    float dx = abs(p.x - cx) - halfLen;
    return length(vec2(max(dx, 0.0), length(vec2(p.y - y, p.z - zOff)))) - r;
}
float sdLogZ(vec3 p, float cz, float halfLen, float y, float xOff, float r)
{
    float dz = abs(p.z - cz) - halfLen;
    return length(vec2(max(dz, 0.0), length(vec2(p.y - y, p.x - xOff)))) - r;
}
float sdCylY(vec3 p, vec2 c, float y0, float y1, float r)
{
    float qr = length(p.xz - c) - r;
    float qy = max(y0 - p.y, p.y - y1);
    return length(max(vec2(qr, qy), vec2(0.0))) + min(max(qr, qy), 0.0);
}
float houseDistance(vec3 p)
{
    vec3 q = vec3(p.x - kHousePosG.x, p.y - kPadYG, p.z - kHousePosG.y);
    const float hx = 2.6, hz = 2.0;
    float best = sdBoxF(q, vec3(0.0, 0.05, 0.0), vec3(hx + 0.28, 0.30, hz + 0.28));
    const float lr = 0.145, pitch = 0.27;
    float wall = 1e9;
    for (int k = 0; k < 8; ++k) {
        float y = 0.42 + lr + float(k) * pitch;
        if (k % 2 == 0)
            wall = min(wall, min(sdLogX(q, 0.0, hx, y, hz, lr),
                                 sdLogX(q, 0.0, hx, y, -hz, lr)));
        else
            wall = min(wall, min(sdLogZ(q, 0.0, hz, y, hx, lr),
                                 sdLogZ(q, 0.0, hz, y, -hx, lr)));
    }
    float door = sdBoxF(q, vec3(-0.7, 1.30, -hz), vec3(0.52, 0.95, 0.6));
    float winA = sdBoxF(q, vec3(-hx, 1.62, 0.75), vec3(0.6, 0.42, 0.45));
    float winB = sdBoxF(q, vec3(hx, 1.62, 0.75), vec3(0.6, 0.42, 0.45));
    wall = max(wall, max(-door, max(-winA, -winB)));
    best = min(best, wall);
    float ry0 = 0.42 + lr + 7.0 * pitch + 0.22;
    for (int i = 0; i < 10; ++i) {
        float rz = mix(hz + 0.66, 0.14, float(i) / 9.0);
        best = min(best, sdBoxF(q, vec3(0.0, ry0 + float(i) * 0.145, 0.0),
                                vec3(hx + 0.58, 0.09, rz)));
    }
    best = min(best, sdBoxF(q, vec3(1.55, ry0 + 0.85, 0.75), vec3(0.30, 1.45, 0.30)));
    return best;
}
const vec2 kTreeSpots[6] = vec2[6](vec2(10.5, 11.5), vec2(2.0, 17.0),
                                   vec2(-6.0, 20.0), vec2(14.0, 4.0),
                                   vec2(18.0, 16.0), vec2(15.0, 22.0));
const vec2 kRockSpots[3] = vec2[3](vec2(3.0, 9.0), vec2(11.5, 9.0), vec2(-1.0, 4.5));
const float kRockRadii[3] = float[3](0.85, 0.65, 1.00);

float treeDistance(vec3 p, vec2 spot, float groundY)
{
    vec3 q = vec3(p.x - spot.x, p.y - groundY, p.z - spot.y);
    float d = sdCylY(q, vec2(0.0), -0.05, 0.20, 0.37);
    d = min(d, sdCylY(q, vec2(0.0), 0.20, 0.45, 0.28));
    d = min(d, sdCylY(q, vec2(0.0), 0.45, 1.70, 0.235));
    d = min(d, sdCylY(q, vec2(0.0), 1.70, 2.70, 0.195));
    d = min(d, sdCylY(q, vec2(0.0), 2.70, 3.25, 0.165));
    d = min(d, length(q - vec3(-0.45, 3.75, 0.30)) - 1.50);
    d = min(d, length(q - vec3(0.50, 4.35, -0.25)) - 1.70);
    d = min(d, length(q - vec3(0.00, 5.25, 0.10)) - 1.50);
    d = min(d, length(q - vec3(0.10, 6.05, -0.05)) - 1.05);
    return d;
}
float treesDistance(vec3 p)
{
    float best = 1e9;
    for (int i = 0; i < 6; ++i) {
        float gy = heightAt(kTreeSpots[i]);
        if (dot(p.xz - kTreeSpots[i], p.xz - kTreeSpots[i]) > 16.0 || p.y > gy + 8.4)
            continue;
        best = min(best, treeDistance(p, kTreeSpots[i], gy));
    }
    return best;
}
float rocksDistance(vec3 p)
{
    float best = 1e9;
    for (int i = 0; i < 3; ++i) {
        float r = kRockRadii[i];
        float dx = p.x - kRockSpots[i].x, dz = p.z - kRockSpots[i].y;
        if (dx * dx + dz * dz > (r + 0.4) * (r + 0.4))
            continue;
        vec3 c = vec3(kRockSpots[i], heightAt(kRockSpots[i]) + r * 0.30);
        best = min(best, length(p - c) - r);
    }
    return best;
}

const float kBushCell = 6.0;

float bushesDistance(vec3 p)
{
    float best = 1e9;
    float cell = kBushCell;
    int ix = int(floor(p.x / cell));
    int iz = int(floor(p.z / cell));
    for (int dz = -1; dz <= 1; ++dz) for (int dx = -1; dx <= 1; ++dx) {
        int cx = ix + dx, cz = iz + dz;
        float hCell = hashN(vec2(float(cx) * 19.1, float(cz) * 37.7));
        if (hCell < 0.62) continue;
        float jx = hashN(vec2(float(cx) * 7.3, float(cz) * 11.1));
        float jz = hashN(vec2(float(cx) * 13.7, float(cz) * 17.3));
        float hr = hashN(vec2(float(cx) * 23.1, float(cz) * 29.7));
        vec2 center = vec2((float(cx) + jx) * cell, (float(cz) + jz) * cell);
        float H = heightAt(center);
        // material/slope cull (approximate heightmap material check)
        float wd = kWaterLevel - H;
        if (wd > -0.02) continue;
        float e = 0.5;
        float sx = heightAt(center + vec2(e,0.0)) - heightAt(center - vec2(e,0.0));
        float sz = heightAt(center + vec2(0.0,e)) - heightAt(center - vec2(0.0,e));
        float slope = length(vec2(sx, sz)) * (0.5 / e);
        if (slope > 0.9) continue;
        // quick vertical cull
        if (p.y < H - 0.5 || p.y > H + 2.5) continue;
        float r = 0.35 + hr * 0.45;
        vec3 c = vec3(center.x, H + r * 0.55, center.y);
        float d = length(p - c) - r;
        best = min(best, d);
    }
    return best;
}

float objectDistance(vec3 p)
{
    return min(houseDistance(p), min(min(treesDistance(p), rocksDistance(p)), bushesDistance(p)));
}

uint getMaterialId(vec3 p)
{
    float H = heightAt(p.xz);
    float dT = p.y - H;
    float dH = houseDistance(p);
    float dTr = treesDistance(p);
    float dR = rocksDistance(p);
    float dB = bushesDistance(p);
    float dO = min(dH, min(min(dTr, dR), dB));
    if (dO + 0.01 < dT) {
        if (dB <= dH && dB <= dTr && dB <= dR) return 8u;
        if (dH <= dTr && dH <= dR) {
            vec3 q = vec3(p.x - kHousePosG.x, p.y - kPadYG, p.z - kHousePosG.y);
            float ry0 = 0.42 + 0.145 + 7.0 * 0.27 + 0.22;
            if (q.y > ry0 - 0.05) return 7u;
            if (q.y < 0.33) return 4u;
            return 6u;
        } else if (dTr <= dR) {
            // foliage is high, trunk low
            // find closest tree ground to decide foliage vs trunk
            float bestGy = 1e9;
            for (int i = 0; i < 6; ++i) {
                float gy = heightAt(kTreeSpots[i]);
                float d2 = dot(p.xz - kTreeSpots[i], p.xz - kTreeSpots[i]);
                if (d2 < 4.0) bestGy = min(bestGy, gy);
            }
            if (p.y > bestGy + 3.0) return 8u;
            return 6u;
        } else {
            return 4u;
        }
    }
    float wd = kWaterLevel - H;
    float e = 0.5;
    float sx = heightAt(p.xz + vec2(e,0.0)) - heightAt(p.xz - vec2(e,0.0));
    float sz = heightAt(p.xz + vec2(0.0,e)) - heightAt(p.xz - vec2(0.0,e));
    float slope = length(vec2(sx, sz)) * (0.5 / e);
    float n = vnoise(p.xz * 0.35);
    if (wd > 0.55) return n > 0.5 ? 5u : 4u;
    if (wd > -0.02) return 3u;
    if (wd > -0.45) return n > 0.575 ? 3u : 2u;
    if (slope > 0.85) return n > 0.5 ? 4u : 5u;
    if (wd > -1.2) return 2u;
    return n > 0.625 ? 1u : 0u;
}

vec3 calcNormal(vec3 p)
{
    float e = 0.35;
    // dense volume is the single source; sample it directly
    return normalize(vec3(sdfAt(p + vec3(e,0,0)) - sdfAt(p - vec3(e,0,0)),
                          sdfAt(p + vec3(0,e,0)) - sdfAt(p - vec3(0,e,0)),
                          sdfAt(p + vec3(0,0,e)) - sdfAt(p - vec3(0,0,e))));
}

float softShadow(vec3 ro, vec3 rd)
{
    float res = 1.0;
    float t = 0.05;
    for (int i = 0; i < 28; ++i) {
        vec3 sp = ro + rd * t;
        float s = sdfAt(sp);
        res = min(res, 9.0 * s / t);
        t += clamp(s * 0.85, 0.05, 1.2);
        if (res < 0.004 || t > 40.0)
            break;
    }
    return clamp(res, 0.0, 1.0);
}

vec3 skyColor(vec3 d)
{
    float cosTheta = clamp(d.y, 0.0, 1.0);
    float cosGamma = max(dot(d, kSunDir), 0.0);
    float gamma = acos(clamp(cosGamma, 0.0, 1.0));
    const float T = 2.2;
    float Ay = 0.1787 * T - 1.4630;
    float By = -0.3554 * T + 0.4275;
    float Cy = -0.0227 * T + 5.3251;
    float Dy = 0.1206 * T - 2.5771;
    float Ey = -0.0670 * T + 0.3703;
    float cosThetaSafe = max(cosTheta, 0.07);
    float Ftheta = (1.0 + Ay * exp(By / cosThetaSafe)) / (1.0 + Ay * exp(By));
    float Fgamma = 1.0 + Cy * exp(Dy * gamma) + Ey * cosGamma * cosGamma;
    float Y = Ftheta * Fgamma;
    vec3 base = mix(kHorizon * 1.05, kZenith * 0.95, pow(max(cosTheta, 0.0), 0.55));
    vec3 col = base * (0.82 + 0.30 * clamp(Y * 0.08, 0.0, 1.5));
    col += kSunCol * 0.55 * pow(cosGamma, 1150.0) * clamp(Y * 0.15, 0.0, 2.0);
    col += vec3(1.0, 0.85, 0.6) * 0.48 * pow(cosGamma, 6.0) * clamp(Y * 0.06, 0.2, 1.2);
    return col;
}

vec3 grassDetail(vec3 alb, vec3 p, inout vec3 n)
{
    float g = fract(sin(dot(floor(p.xz*14.0), vec2(12.9898,78.233))) * 43758.5453);
    n = normalize(n + 0.18*vec3(g-0.5, 0.0, fract(g*7.31)-0.5));
    return alb * (0.82 + 0.36*g);
}

// analytic water surface hit along ray; returns t or -1
float waterHit(vec3 ro, vec3 rd, float tMax)
{
    if (rd.y > -0.001) return -1.0;
    float tw = (kWaterLevel - ro.y) / rd.y;
    if (tw < 0.0 || tw > tMax) return -1.0;
    vec3 pw = ro + rd * tw;
    return underWater(pw.xz) ? tw : -1.0;
}

vec3 aces(vec3 x){
    return clamp((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14),0.0,1.0);
}

bool rayAABB(vec3 ro, vec3 invRd, out float t0, out float t1)
{
    vec3 half_ = vec3(pc.b.x * 0.5);
    vec3 tv0 = (-half_ - ro) * invRd;
    vec3 tv1 = (half_ - ro) * invRd;
    vec3 tsm = min(tv0, tv1), tbg = max(tv0, tv1);
    t0 = max(max(tsm.x, tsm.y), tsm.z);
    t1 = min(min(tbg.x, tbg.y), tbg.z);
    return t1 >= max(t0, 0.0);
}

vec3 shadeTerrain(vec3 p, vec3 rd, vec3 alb)
{
    vec3 n = calcNormal(p);

    float sh = softShadow(p + n * 0.35, kSunDir);
    float ndl = max(dot(n, kSunDir), 0.0);
    
    vec3 amb = mix(kHorizon, kZenith, 0.5) * (n.y * 0.5 + 0.5) * 0.55;
    vec3 bounce = vec3(0.30, 0.25, 0.18) * max(-n.y, 0.0) * 0.35;
    if (alb.g > alb.r * 1.15) { // vegetation: micro detail
        alb = grassDetail(alb, p, n);
        sh = min(sh, softShadow(p + n * 0.35, kSunDir) + 0.15);
    }
    vec3 col = alb * (kSunCol * ndl * sh + amb + bounce);
    // PBR-ish specular from per-voxel roughness/reflectivity
    {
        uint matId = getMaterialId(p);
        vec2 rr = kMatRefl[matId];
        float rough = rr.y;
        float refl = rr.x;
        vec3 V = -rd;
        vec3 Hh = normalize(kSunDir + V);
        float NdotH = max(dot(n, Hh), 0.0);
        float specPow = mix(128.0, 8.0, rough);
        float spec = pow(NdotH, specPow) * refl * sh * 0.7;
        col += kSunCol * spec;
    }

    if (p.y < kWaterLevel && underWater(p.xz)) {
        float depth = kWaterLevel - p.y;
        col *= exp(-depth * vec3(0.35, 0.18, 0.12) * 3.0);
        col = mix(col, vec3(0.05, 0.14, 0.13), clamp(depth * 0.8, 0.0, 0.85));
    }
    return col;
}

void main()
{
    kSunDir = normalize(pc.sunDir.xyz);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.a.z) || pix.y >= int(pc.a.w))
        return;

    vec2 ndc = (gl_GlobalInvocationID.xy + 0.5) / vec2(pc.a.z, pc.a.w) * 2.0 - 1.0;
    vec2 uv = vec2(ndc.x, -ndc.y); // image row 0 is the TOP row -> NDC +Y
    vec3 rd = normalize(pc.camFwd.xyz + uv.x * pc.a.x * pc.a.y * pc.camRight.xyz +
                        uv.y * pc.a.x * pc.camUp.xyz);
    vec3 ro = pc.camPos.xyz;

    vec3 col;
    float t0, t1;
    if (!rayAABB(ro, 1.0 / rd, t0, t1)) {
        col = skyColor(rd);
    } else {
        float t = max(t0, 0.0);
        bool hit = false;
        const int kMaxSteps = 192;
        for (int i = 0; i < kMaxSteps; ++i) {
            vec3 p = ro + rd * t;
            float s = sdfAt(p);
            if (s < pc.b.z * 0.45) { // hit threshold ~ half voxel
                hit = true;
                break;
            }
            t += max(s * 0.92, pc.b.z * 0.35); // relaxed march, never sub-voxel stall
            if (t > t1)
                break;
        }

        if (hit) {
            vec3 p = ro + rd * t;
            vec3 albedo = albedoAt(p);

            // water surface between camera and terrain?
            float tWater = waterHit(ro, rd, min(t1, t));
            bool waterView = false;
            if (tWater > 0.0 && t <= t1) {
                vec3 pw = ro + rd * tWater;
                t = tWater; hit = true; waterView = true;
            }

            if (waterView) {
                vec3 pw = ro + rd * tWater;
                float r1 = sin(pw.x*4.5 + pc.misc.y*0.45)*0.5 + sin(pw.z*6.0 - pw.x*2.5)*0.5;
                vec3 n = normalize(vec3(r1*0.04, 1.0, sin(pw.x*3.5 - pw.z*5.5)*0.04));
                vec3 R = reflect(rd, n);
                R.y = abs(R.y);
                vec3 rc = skyColor(R);
                float rt = max(t0,0.0); bool rh=false;
                vec3 rp2 = pw;
                for (int i=0;i<64;++i){
                    float s=sdfAt(rp2);
                    if (s<0.03){rh=true;break;}
                    rp2 += R * max(s*0.85, 0.05);
                    if (dot(rp2,rp2) > 26000.0) break;
                }
                if (rh){
                    vec3 hp2 = rp2;
                    vec3 hn = calcNormal(hp2);
                    rc = shadeTerrain(hp2, R, albedoAt(hp2));
                }
                float fres = 0.02 + 0.98*pow(1.0 - max(dot(-rd,n),0.0), 5.0);
                float sunGlint = pow(max(dot(R,kSunDir),0.0), 420.0);
                col = mix(vec3(0.04,0.10,0.09), rc, clamp(fres+0.25,0.0,1.0))
                      + kSunCol * sunGlint * 3.0;
                // shoreline foam: thin streaks hugging the waterline
                float bedH = heightAt(pw.xz);
                float shoreF = 1.0 - smoothstep(0.02, 0.26, kWaterLevel - bedH);
                float fp = vnoise(pw.xz * 3.7 + vec2(pc.misc.y * 0.35, -pc.misc.y * 0.22));
                fp = smoothstep(0.66, 0.90, fp + 0.28 * shoreF - 0.20);
                col = mix(col, vec3(0.92, 0.94, 0.95), fp * shoreF * 0.50);
                col = mix(col, kHorizon*1.05, 1.0-exp(-tWater*0.004));
            } else {
                col = shadeTerrain(p, rd, albedo);
            }

            float fog = 1.0 - exp(-max(t - t0, 0.0) * 0.0012);
            col = mix(col, kHorizon * 1.05, fog);
        } else {
            col = skyColor(rd);
        }
    }

    col = aces(col);
    col = clamp(mix(vec3(dot(col, vec3(0.2126, 0.7152, 0.0722))), col, 1.55),
                vec3(0.0), vec3(1.0));
    col = pow(col, vec3(1.0 / 2.2)); // gamma
    imageStore(uOut, pix, vec4(col, 1.0));
}
