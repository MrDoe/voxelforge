#version 460
// Weighted-blended OIT composite for --mode 3dgs.
//
// The splat OIT pass (PASS_MODE 5) sums premultiplied colour and alpha into
// `uAccum` additively, and multiplies `uReveal` by (1-alpha) for every disk.
// `uBackdrop` holds the sky. `uBase` is the STANDARD depth-resolved splat
// frame (the shipped renderer's output), copied before this pass.
//
// OIT alone changes the WHOLE frame: every splat along a ray contributes to
// the averaged colour, so the front/back of an object blend together. The user
// requirement is that ONLY silhouette edges are transparent - solid interiors
// must stay exactly as the shipped renderer drew them. `uAccum.a` is a direct
// coverage measure (sum of weighted alphas): high inside a solid surface, low
// at a lone splat on a silhouette. So:
//
//   T     = reveal.r
//   oit   = accum.rgb / max(accum.a, eps) * (1 - T) + backdrop * T
//   edge  = 1 - smoothstep(lo, hi, accum.a)
//   colour = mix(base, oit, edge)
//
// At a solid interior (accum.a >> hi) this is bit-identical to `base`. At a
// silhouette (accum.a < lo) the OIT transmittance takes over, and the low-alpha
// front splat reveals the splats it overlaps instead of just the sky.
//
// No push constants: everything this pass needs is in the five storage images.

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uAccum;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D uReveal;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D uBackdrop;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D uHdr;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D uBase;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uHdr);
    if (any(greaterThanEqual(p, sz)))
        return;

    vec4 acc = imageLoad(uAccum, p);
    float T = clamp(imageLoad(uReveal, p).r, 0.0, 1.0);
    vec3 avg = acc.a > 1e-5 ? acc.rgb / acc.a : vec3(0.0);
    vec3 bg = imageLoad(uBackdrop, p).rgb;
    vec3 oit = avg * (1.0 - T) + bg * T;

    // Coverage gate: only sparse-coverage pixels become translucent. Use the
    // unweighted transmittance T rather than accum.a: the latter carries the
    // depth weight (hundreds on a solid surface), while T is a pure Π(1-alpha)
    // in [0,1]. A solid interior has T ~ 0; a lone low-alpha silhouette splat
    // has T close to 1. Sky also has T = 1, but there oit == base == backdrop,
    // so the mix is harmless there.
    float edge = smoothstep(0.08, 0.6, T);
    vec3 base = imageLoad(uBase, p).rgb;
    imageStore(uHdr, p, vec4(mix(base, oit, edge), 1.0));
}
