#version 460
#extension GL_GOOGLE_include_directive : require
// Voxelforge - Screen-Space Reflections.
// Pure LDR post effect: marches the reflected ray through the world-pos
// G-buffer (proper camera projection) and blends scene color / sky.
// Operates on the tonemapped offscreen image in place.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uScene;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D uGPos;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uOut;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, voxelSize, gridN, frameIdx
    vec4 sunDir;
    vec4 misc; // x=renderFlags, y=animTime, z=tonemapLook, w=exposure
} pc;

const float kWaterLevel = -0.9;
const int kMaxSteps = 64;
const float kStepScale = 0.5;

int gRenderFlags = 31;

vec3 skyColor(vec3 d)
{
    float cosTheta = clamp(d.y, 0.0, 1.0);
    float cosGamma = max(dot(d, normalize(pc.sunDir.xyz)), 0.0);
    float gamma = acos(clamp(cosGamma, 0.0, 1.0));
    const float T = 2.2;
    float Ay = 0.1787 * T - 1.4630;
    float By = -0.3554 * T + 0.4275;
    float Cy = -0.0227 * T + 5.3251;
    float Dy = 0.1206 * T - 2.5771;
    float Ey = -0.0670 * T + 0.3703;
    float cosThetaSafe = max(cosTheta, 0.07);
    float Ftheta = (1.0 + Ay * exp(By / cosThetaSafe)) / (1.0 + Ay * exp(By));
    float Fgamma = 1.0 + Cy * exp(Dy * gamma) + Ey * cosGamma * cosGamma;
    float Y = Ftheta * Fgamma;
    vec3 base = mix(vec3(0.72, 0.80, 0.90) * 1.05, vec3(0.20, 0.36, 0.62) * 0.95, pow(max(cosTheta, 0.0), 0.55));
    vec3 col = base * (0.82 + 0.30 * clamp(Y * 0.08, 0.0, 1.5));
    col += vec3(1.0, 0.95, 0.84) * 1.35 * 0.55 * pow(cosGamma, 1150.0) * clamp(Y * 0.15, 0.0, 2.0);
    col += vec3(1.0, 0.85, 0.6) * 0.48 * pow(cosGamma, 6.0) * clamp(Y * 0.06, 0.2, 1.2);
    return col;
}

// project a world position to pixel coords with the current camera;
// false when behind the near plane
bool projectToPixel(vec3 sp, out vec2 px)
{
    vec3 rel = sp - pc.camPos.xyz;
    float cz = dot(rel, pc.camFwd.xyz);
    if (cz < 0.1)
        return false;
    float cx = dot(rel, pc.camRight.xyz);
    float cy = dot(rel, pc.camUp.xyz);
    vec2 ndc = vec2(cx / (cz * pc.a.x * pc.a.y), -cy / (cz * pc.a.x));
    px = (ndc * 0.5 + 0.5) * vec2(pc.a.z, pc.a.w);
    return true;
}

vec3 gposClamped(ivec2 pix)
{
    ivec2 ext = ivec2(int(pc.a.z), int(pc.a.w));
    return imageLoad(uGPos, clamp(pix, ivec2(0), ext - ivec2(1))).xyz;
}

void main()
{
    gRenderFlags = int(pc.misc.x + 0.5);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.a.z) || pix.y >= int(pc.a.w)) return;

    vec4 gp = imageLoad(uGPos, pix);
    vec3 worldPos = gp.xyz;
    float hitType = gp.w; // 0 sky, 1 solid, 2 water

    vec3 baseCol = imageLoad(uScene, pix).rgb;
    if (hitType < 0.5) {
        imageStore(uOut, pix, vec4(baseCol, 1.0));
        return;
    }

    // surface normal from G-buffer finite differences, faced toward viewer
    vec3 dpdx = gposClamped(pix + ivec2(1, 0)) - gposClamped(pix - ivec2(1, 0));
    vec3 dpdy = gposClamped(pix + ivec2(0, 1)) - gposClamped(pix - ivec2(0, 1));
    vec3 n = normalize(cross(dpdy, dpdx) + vec3(1e-6));
    vec3 viewDir = normalize(pc.camPos.xyz - worldPos);
    if (dot(n, viewDir) < 0.0)
        n = -n;

    vec3 rd = reflect(-viewDir, n);

    // march the reflected ray; a G-buffer sample close to the marched point
    // counts as a reflection hit
    vec3 col = skyColor(normalize(rd));
    float t = 0.1;
    for (int i = 0; i < kMaxSteps; ++i) {
        vec3 sp = worldPos + rd * t;
        vec2 px;
        if (projectToPixel(sp, px)) {
            if (px.x >= 0.0 && px.y >= 0.0 && px.x < pc.a.z && px.y < pc.a.w) {
                vec4 g = imageLoad(uGPos, ivec2(int(px.x), int(px.y)));
                if (g.w > 0.5 && length(g.xyz - sp) < 0.3) {
                    col = imageLoad(uScene, ivec2(int(px.x), int(px.y))).rgb;
                    break;
                }
            }
        }
        t += kStepScale;
        if (t > 30.0)
            break;
    }

    // fresnel-weighted blend; water reflects more at all angles
    float fresnel = pow(1.0 - max(dot(viewDir, n), 0.0), 3.0);
    float amt = (hitType > 1.5) ? max(fresnel * 0.8, 0.30) : fresnel * 0.8;
    vec3 result = mix(baseCol, col, clamp(amt, 0.0, 1.0));
    imageStore(uOut, pix, vec4(result, 1.0));
}
