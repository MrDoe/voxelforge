#version 460
#extension GL_GOOGLE_include_directive : require
// Voxelforge - Screen-Space Reflections.
// Pure LDR post effect: marches the reflected ray through the world-pos
// G-buffer (proper camera projection) and blends scene color / sky.
// Operates on the tonemapped offscreen image in place.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uScene;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D uGPos;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uOut;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D uGNorm;
// Guidance lane: rgb = effective albedo, a = roughness. Wet soil (mat 22) has
// low roughness, so its reflections are strong; dry soil/matte surfaces keep
// the historical Fresnel-only amount. Bit 12 opts in; bit 12 off = old behaviour.
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D uGAlb;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, voxelSize, gridN, frameIdx
    vec4 sunDir;
    vec4 misc; // x=renderFlags, y=animTime, z=tonemapLook, w=exposure
} pc;

const float kWaterLevel = -0.9;
const int kMaxSteps = 32;

int gRenderFlags = 31;

vec3 skyColor(vec3 d)
{
    float cosTheta = clamp(d.y, 0.0, 1.0);
    float cosGamma = max(dot(d, normalize(pc.sunDir.xyz)), 0.0);
    float gamma = acos(clamp(cosGamma, 0.0, 1.0));
    const float T = 2.2;
    float Ay = 0.1787 * T - 1.4630;
    float By = -0.3554 * T + 0.4275;
    float Cy = -0.0227 * T + 5.3251;
    float Dy = 0.1206 * T - 2.5771;
    float Ey = -0.0670 * T + 0.3703;
    float cosThetaSafe = max(cosTheta, 0.07);
    float Ftheta = (1.0 + Ay * exp(By / cosThetaSafe)) / (1.0 + Ay * exp(By));
    float Fgamma = 1.0 + Cy * exp(Dy * gamma) + Ey * cosGamma * cosGamma;
    float Y = Ftheta * Fgamma;
    vec3 base = mix(vec3(0.72, 0.80, 0.90) * 1.05, vec3(0.20, 0.36, 0.62) * 0.95, pow(max(cosTheta, 0.0), 0.55));
    vec3 col = base * (0.82 + 0.30 * clamp(Y * 0.08, 0.0, 1.5));
    col += vec3(1.0, 0.95, 0.84) * 1.35 * 0.55 * pow(cosGamma, 1150.0) * clamp(Y * 0.15, 0.0, 2.0);
    col += vec3(1.0, 0.85, 0.6) * 0.48 * pow(cosGamma, 6.0) * clamp(Y * 0.06, 0.2, 1.2);
    return col;
}

// project a world position to pixel coords with the current camera;
// false when behind the near plane
bool projectToPixel(vec3 sp, out vec2 px)
{
    vec3 rel = sp - pc.camPos.xyz;
    float cz = dot(rel, pc.camFwd.xyz);
    if (cz < 0.1)
        return false;
    float cx = dot(rel, pc.camRight.xyz);
    float cy = dot(rel, pc.camUp.xyz);
    vec2 ndc = vec2(cx / (cz * pc.a.x * pc.a.y), -cy / (cz * pc.a.x));
    px = (ndc * 0.5 + 0.5) * vec2(pc.a.z, pc.a.w);
    return true;
}

vec3 gposClamped(ivec2 pix)
{
    ivec2 ext = ivec2(int(pc.a.z), int(pc.a.w));
    return imageLoad(uGPos, clamp(pix, ivec2(0), ext - ivec2(1))).xyz;
}

void main()
{
    gRenderFlags = int(pc.misc.x + 0.5);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.a.z) || pix.y >= int(pc.a.w)) return;

    vec4 gp = imageLoad(uGPos, pix);
    vec3 worldPos = gp.xyz;
    float hitType = gp.w; // 0 sky, 1 solid, 2 water

    vec3 baseCol = imageLoad(uScene, pix).rgb;
    if (hitType < 0.5) {
        imageStore(uOut, pix, vec4(baseCol, 1.0));
        return;
    }

    // Surface normal from the G-buffer (written by both backends; water
    // stores the flat plane normal). Degenerate (0) normals fall back to the
    // old finite-difference reconstruction so a missing writer degrades
    // gracefully instead of reflecting off garbage.
    vec3 n = imageLoad(uGNorm, pix).xyz;
    if (dot(n, n) < 1e-6) {
        vec3 dpdx = gposClamped(pix + ivec2(1, 0)) - gposClamped(pix - ivec2(1, 0));
        vec3 dpdy = gposClamped(pix + ivec2(0, 1)) - gposClamped(pix - ivec2(0, 1));
        n = normalize(cross(dpdy, dpdx) + vec3(1e-6));
    } else {
        n = normalize(n);
    }
    vec3 viewDir = normalize(pc.camPos.xyz - worldPos);
    if (dot(n, viewDir) < 0.0)
        n = -n;

    vec3 rd = reflect(-viewDir, n);

    // Fresnel-weighted blend; water reflects more at all angles. Compute it
    // before the march so matte, face-on surfaces can skip SSR entirely.
    const float kReflStrength = 0.22; // peak blend on solids
    const float kReflWaterFloor = 0.10; // minimum blend on water
    float fresnel = pow(1.0 - max(dot(viewDir, n), 0.0), 3.0);
    float amt = (hitType > 1.5) ? max(fresnel * kReflStrength, kReflWaterFloor)
                                : fresnel * kReflStrength;
    // Wet-surface reflections (render-flag bit 12): use the guidance lane's
    // roughness (a = 150/55 for wet soil -> ~0.22; dry soil ~0.88).
    if ((gRenderFlags & 4096) != 0 && hitType < 1.5) {
        float rough = clamp(imageLoad(uGAlb, pix).a, 0.0, 1.0);
        float gloss = 1.0 - smoothstep(0.20, 0.32, rough);
        amt = max(amt, gloss * 0.55);
    }
    if (amt <= 0.006) {
        imageStore(uOut, pix, vec4(baseCol, 1.0));
        return;
    }

    // Depth-aware reflected-ray march. The old proximity-only test could
    // accept a surface behind an intervening wall and used sky whenever the
    // ray left the screen. Compare the ray's view depth with the visible
    // G-buffer depth at every step. Once the ray crosses behind a visible
    // surface, that surface is the reflection hit: sample the current pixel
    // directly instead of spending extra taps on a refinement.
    const vec3 rayOrigin = worldPos + n * 0.035;
    vec3 col = skyColor(rd);
    bool reflected = false;
    bool skyAllowed = true;
    float t = 0.04;
    const vec2 extent = vec2(pc.a.z, pc.a.w);
    for (int i = 0; i < kMaxSteps; ++i) {
        const vec3 sp = rayOrigin + rd * t;
        vec2 px;
        if (!projectToPixel(sp, px) || px.x < 0.0 || px.y < 0.0 ||
            px.x >= extent.x || px.y >= extent.y) {
            // Screen-space data cannot prove that an off-screen reflection is
            // visible. Conservatively keep the base surface instead of
            // leaking bright sky through an off-screen wall.
            skyAllowed = false;
            break;
        }

        const ivec2 ip = ivec2(int(px.x), int(px.y));
        const vec4 g = imageLoad(uGPos, ip);
        const float rayDepth = dot(sp - pc.camPos.xyz, pc.camFwd.xyz);
        const float pixelWorld = max(0.018,
            2.0 * pc.a.x * max(rayDepth, 0.1) / max(extent.y, 1.0));
        const float thickness = clamp(pixelWorld * 0.65, 0.018, 0.22);
        const bool sourcePixel = abs(ip.x - pix.x) <= 1 && abs(ip.y - pix.y) <= 1 &&
                                 t < 0.35;

        if (g.w > 0.5 && !sourcePixel) {
            const float sceneDepth = dot(g.xyz - pc.camPos.xyz, pc.camFwd.xyz);
            if (rayDepth > sceneDepth + thickness) {
                // The ray crossed behind visible geometry. The current pixel
                // already shows that nearest surface, so it is the correct
                // reflection colour; never fall through to sky/source behind it.
                col = imageLoad(uScene, ip).rgb;
                reflected = true;
                skyAllowed = false;
                break;
            }

            if (t > 0.12 && length(g.xyz - sp) < thickness) {
                col = imageLoad(uScene, ip).rgb;
                reflected = true;
                break;
            }
        }

        // Grow with travelled distance, but cap at half a metre so a step
        // cannot jump over a thin vertical emitter. Depth crossing still
        // catches walls while useful SSR range costs fewer than 64 taps.
        t += clamp(0.08 + t * 0.05, 0.08, 0.5);
        if (t > 32.0)
            break;
    }

    if (!reflected && !skyAllowed)
        col = baseCol;
    vec3 result = mix(baseCol, col, clamp(amt, 0.0, 1.0));
    imageStore(uOut, pix, vec4(result, 1.0));
}
