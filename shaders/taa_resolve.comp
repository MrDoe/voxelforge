#version 460
// TAA resolve: temporal blend current with history, AABB-clamped to avoid ghosting.
// History is reprojected using the world-position G-buffer (uGPos) and the
// previous frame's camera, so camera motion no longer blends mismatched pixels.
// History is in GENERAL layout, current is same offscreen image after raymarch (GENERAL).
// Shadow-border hardening: absolute AABB floor (LDR history quantizes dark
// shadows coarsely) + motion-adaptive clamp relaxation so a moving shadow
// border keeps temporal smoothing instead of rejecting history every frame.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8)  uniform readonly image2D uCurrent;
layout(set = 0, binding = 1, rgba8)  uniform readonly image2D uHistory;
layout(set = 0, binding = 2, rgba8)  uniform writeonly image2D uOut;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D uGPos; // world pos .xyz, hitType .w

layout(push_constant) uniform PC {
    vec4 extentInv;    // x=1/W, y=1/H, z=blendFactor, w=firstFrame(1/0)
    vec4 prevCamPos;
    vec4 prevCamRight;
    vec4 prevCamUp;
    vec4 prevCamFwd;
    vec4 prevParams;   // x=tanHalfFov, y=aspect
} pc;

vec3 clipAABB(vec3 aabbMin, vec3 aabbMax, vec3 p, vec3 q) {
    vec3 r = q - p;
    vec3 rcp = vec3(r.x != 0.0 ? 1.0/r.x : 1e9, r.y != 0.0 ? 1.0/r.y : 1e9, r.z != 0.0 ? 1.0/r.z : 1e9);
    vec3 dmin = (aabbMin - p) * rcp;
    vec3 dmax = (aabbMax - p) * rcp;
    vec3 d0 = min(dmin, dmax);
    vec3 d1 = max(dmin, dmax);
    float t0 = max(max(d0.x, d0.y), d0.z);
    float t1 = min(min(d1.x, d1.y), d1.z);
    t0 = clamp(t0, 0.0, 1.0);
    return mix(p, q, t0);
}

// Bilinear sample of the history storage image (storage images can't use a sampler here).
vec3 sampleHist(vec2 uv) {
    ivec2 sz = imageSize(uHistory);
    vec2 f = uv * vec2(sz) - 0.5;
    vec2 base = floor(f);
    vec2 t = f - base;
    ivec2 p00 = ivec2(base);
    ivec2 p11 = p00 + ivec2(1, 1);
    ivec2 c00 = clamp(p00,            ivec2(0), sz - ivec2(1));
    ivec2 c10 = clamp(ivec2(p00.x+1, p00.y), ivec2(0), sz - ivec2(1));
    ivec2 c01 = clamp(ivec2(p00.x, p00.y+1), ivec2(0), sz - ivec2(1));
    ivec2 c11 = clamp(p11,            ivec2(0), sz - ivec2(1));
    vec3 s00 = imageLoad(uHistory, c00).rgb;
    vec3 s10 = imageLoad(uHistory, c10).rgb;
    vec3 s01 = imageLoad(uHistory, c01).rgb;
    vec3 s11 = imageLoad(uHistory, c11).rgb;
    return mix(mix(s00, s10, t.x), mix(s01, s11, t.x), t.y);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uCurrent);
    if (pix.x >= sz.x || pix.y >= sz.y) return;

    vec4 cur = imageLoad(uCurrent, pix);
    if (pc.extentInv.w > 0.5) {
        imageStore(uOut, pix, cur);
        return;
    }

    // 3x3 neighbourhood AABB of current (for clamping history)
    vec3 nmin = vec3( 1e9), nmax = vec3(-1e9);
    vec3 m0 = vec3(0.0);
    for (int dy=-1; dy<=1; ++dy) for (int dx=-1; dx<=1; ++dx) {
        ivec2 p = clamp(pix + ivec2(dx,dy), ivec2(0), sz - ivec2(1));
        vec3 c = imageLoad(uCurrent, p).rgb;
        nmin = min(nmin, c);
        nmax = max(nmax, c);
        if (dx==0 && dy==0) m0 = c;
    }
    vec3 range = nmax - nmin;
    // Absolute floor (~3 LDR codes): flat dark shadow interiors would otherwise
    // quantize history rejection to zero smoothing, letting per-frame coverage
    // pops through as flicker. The relative term keeps wide borders clampable.
    vec3 pad = range * 0.12 + vec3(0.012);
    nmin -= pad; nmax += pad;

    // Reproject the previous frame's history onto this pixel using the world
    // position written by the raymarch pass and the previous camera basis.
    vec3 histCol = cur.rgb;
    vec2 cuv = (vec2(pix) + 0.5) * pc.extentInv.xy;
    vec2 puv = cuv;
    float velLen = 0.0;
    bool reprojOk = false;
    vec4 gp = imageLoad(uGPos, pix);
    if (gp.w > 0.5) { // not sky: has a stable world position
        vec3 v = gp.xyz - pc.prevCamPos.xyz;
        float z = dot(v, pc.prevCamFwd.xyz);
        if (z > 0.0) {
            float ndx = dot(v, pc.prevCamRight.xyz) / (z * pc.prevParams.x * pc.prevParams.y);
            float ndy = -dot(v, pc.prevCamUp.xyz)    / (z * pc.prevParams.x);
            puv = vec2(ndx * 0.5 + 0.5, ndy * 0.5 + 0.5);
            if (all(greaterThanEqual(puv, vec2(0.0))) && all(lessThan(puv, vec2(1.0)))) {
                histCol = sampleHist(puv);
                reprojOk = true;
                velLen = length((puv - cuv) * vec2(sz));
            }
        }
    }

    // variance-style clamp (Karlsruhe) + AABB clip to kill ghosting
    vec3 clamped = clamp(histCol, nmin, nmax);
    clamped = clipAABB(nmin, nmax, m0, clamped);

    float alpha = pc.extentInv.z; // base blend factor for history (0.92)
    vec3 histUsed = clamped;
    if (reprojOk) {
        // Screen-edge fade: bilinear history taps clamp at the frame border,
        // so reprojected history near the edge smears - trust current instead.
        vec2 edgePx = min(puv * vec2(sz), vec2(sz) - puv * vec2(sz));
        float edgeFade = smoothstep(0.0, 1.5, min(edgePx.x, edgePx.y));
        // Motion-adaptive clamp relaxation: when the camera moves a shadow
        // border across the screen, the 3x3 neighbourhood can be uniform while
        // the correctly-reprojected history holds the other side of the
        // border. A hard clamp then rejects history every frame, i.e. zero
        // temporal smoothing exactly where baked-surfel coverage pops need it
        // most (= shadow-border flicker). The scene is static, so reprojected
        // history is exact except at disocclusions - relax the clamp in
        // uniform neighbourhoods under motion instead of rejecting it.
        float lrange = max(range.r, max(range.g, range.b));
        float uniformW = 1.0 - smoothstep(0.03, 0.20, lrange);
        float motionW = clamp((velLen - 0.5) / 8.0, 0.0, 1.0);
        float relaxW = motionW * uniformW * 0.6 * edgeFade;
        histUsed = mix(clamped, clamp(histCol, vec3(0.0), vec3(1.0)), relaxW);
        // Bound ghosting trails during fast motion + near screen edges.
        alpha = mix(alpha, 0.55, clamp(velLen / 24.0, 0.0, 1.0));
        alpha *= mix(0.15, 1.0, edgeFade);
    }

    vec3 outCol = mix(cur.rgb, histUsed, alpha);
    imageStore(uOut, pix, vec4(outCol, cur.a));
}
