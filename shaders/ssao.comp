#version 460
#extension GL_GOOGLE_include_directive : require
// Voxelforge - Screen-Space Ambient Occlusion (HBAO-style).
// Samples the G-buffer world positions in a hemisphere pattern per pixel
// to compute occlusion based on horizon angles.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uGPos;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D uCurrent;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uOut;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, voxelSize, gridN, frameIdx
    vec4 sunDir;
    vec4 misc;
} pc;

const float kOcclusionRadius = 0.5;
const int kSamples = 16;
const float kAoLevel = 1.0;

int gRenderFlags = 31;

void main()
{
    gRenderFlags = int(pc.misc.x + 0.5);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.a.z) || pix.y >= int(pc.a.w)) return;

    vec4 gp = imageLoad(uGPos, pix);
    vec3 worldPos = gp.xyz;
    float hitType = gp.w;

    vec3 base = imageLoad(uCurrent, pix).rgb;
    if (hitType < 0.5) {
        imageStore(uOut, pix, vec4(base, 1.0));
        return;
    }

    // Reconstruct view-space position from world position
    vec3 viewPos = worldPos - vec3(-pc.b.x * 0.5);

    // Estimate normal from G-buffer finite differences, faced toward viewer
    vec3 n = vec3(0.0, 1.0, 0.0);
    {
        ivec2 s = ivec2(1, 0);
        vec3 p0 = imageLoad(uGPos, clamp(pix + s, ivec2(0), ivec2(int(pc.a.z), int(pc.a.w)))).xyz;
        vec3 p1 = imageLoad(uGPos, clamp(pix - s, ivec2(0), ivec2(int(pc.a.z), int(pc.a.w)))).xyz;
        vec3 dpdx = p1 - p0;
        s = ivec2(0, 1);
        p0 = imageLoad(uGPos, clamp(pix + s, ivec2(0), ivec2(int(pc.a.z), int(pc.a.w)))).xyz;
        p1 = imageLoad(uGPos, clamp(pix - s, ivec2(0), ivec2(int(pc.a.z), int(pc.a.w)))).xyz;
        vec3 dpdy = p1 - p0;
        n = normalize(cross(dpdy, dpdx) + vec3(1e-6));
        if (dot(n, normalize(pc.camPos.xyz - worldPos)) < 0.0)
            n = -n;
    }

    // Hemisphere sampling for AO: screen-space taps around the pixel.
    // For each tap, the vector to the tapped surface is tested against the
    // pixel normal — neighbours above the tangent plane are occluders
    // (classic depth-difference AO). Strong signal in creases and contact
    // zones, ~zero on open planes. No world->pixel projection involved.
    float ao = 0.0;
    float wSum = 0.0;
    for (int i = 0; i < 10; ++i) {
        float ang = float(i) * 2.39996; // golden-angle spiral
        float rad = 3.0 + float(i) * 1.8; // 3..~19 px
        ivec2 tp = pix + ivec2(int(round(cos(ang) * rad)),
                               int(round(sin(ang) * rad)));
        if (tp.x < 0 || tp.y < 0 || tp.x >= int(pc.a.z) || tp.y >= int(pc.a.w))
            continue;
        vec4 g2 = imageLoad(uGPos, tp);
        if (g2.w < 0.5)
            continue;
        vec3 d = g2.xyz - worldPos;
        float L = length(d);
        if (L < 1e-4 || L > 2.5)
            continue;
        float o = max(dot(n, d / L) - 0.12, 0.0) / (1.0 + L * L * 2.0);
        ao += o;
        wSum += 1.0;
    }

    ao = clamp(ao / max(wSum, 1e-4) * 2.0 * kAoLevel, 0.0, 1.0);
    vec3 darkened = base * (1.0 - ao * 0.75);
    imageStore(uOut, pix, vec4(darkened, 1.0));
}
