#version 460
#extension GL_GOOGLE_include_directive : require
// Voxelforge - Environment map cubemap generation from the current scene.
// Generates a pre-filtered cubemap for IBL by rendering the scene
// into 6 faces of a cubemap with mip levels for roughness.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uSrc; // source scene
layout(set = 0, binding = 1, rgba16f) uniform writeonly imageCube uEnvMap;

layout(push_constant) uniform PC {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    vec4 camFwd;
    vec4 a; // tanHalfFov, aspect, extentX, extentY
    vec4 b; // worldSize, voxelSize, gridN, frameIdx
    vec4 sunDir;
    vec4 misc; // x=face index, y=mip level, z=resolution, w=unused
} pc;

// Face indices: 0=+X, 1=-X, 2=+Y, 3=-Y, 4=+Z, 5=-Z
void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    int face = int(pc.misc.x);
    int mip = int(pc.misc.y);
    int res = int(pc.misc.z) >> mip;
    if (res < 1) return;
    if (pix.x >= res || pix.y >= res) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(res);
    vec3 dir;

    if (face == 0) dir = normalize(vec3(1.0, 1.0 - 2.0 * uv.y, 1.0 - 2.0 * uv.x));
    else if (face == 1) dir = normalize(vec3(-1.0, 1.0 - 2.0 * uv.y, -1.0 + 2.0 * uv.x));
    else if (face == 2) dir = normalize(vec3(2.0 * uv.x - 1.0, 1.0, -(2.0 * uv.y - 1.0)));
    else if (face == 3) dir = normalize(vec3(2.0 * uv.x - 1.0, -1.0, 2.0 * uv.y - 1.0));
    else if (face == 4) dir = normalize(vec3(2.0 * uv.x - 1.0, 1.0 - 2.0 * uv.y, 1.0));
    else dir = normalize(vec3(-(2.0 * uv.x - 1.0), 1.0 - 2.0 * uv.y, -1.0));

    vec3 col = imageLoad(uSrc, pix).rgb;
    // Approximate the sky color for this direction as the environment value
    col = mix(col, vec3(0.2, 0.3, 0.6), 0.3); // fill dark areas

    imageStore(uEnvMap, ivec3(pix, face), vec4(col, 1.0));
}
